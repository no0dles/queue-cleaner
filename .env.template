# Replace the op:// references with the correct 1Password item paths and run:
# op inject -i .env.template -o .env

# Shared defaults. These act as fallbacks for each environment if a value is omitted.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_AMQP_PROTOCOL=amqp
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_PROTOCOL=http
# Optional timeout for RabbitMQ HTTP requests (ms)
RABBITMQ_REQUEST_TIMEOUT_MS=10000

# Test environment (used by default)
RABBITMQ_TEST_HOST=op://RabbitMQ/QueueCleaner/test-host
RABBITMQ_TEST_USERNAME=op://RabbitMQ/QueueCleaner/test-username
RABBITMQ_TEST_PASSWORD=op://RabbitMQ/QueueCleaner/test-password
RABBITMQ_TEST_VHOST=/

# Production environment
RABBITMQ_PROD_HOST=op://RabbitMQ/QueueCleaner/prod-host
RABBITMQ_PROD_USERNAME=op://RabbitMQ/QueueCleaner/prod-username
RABBITMQ_PROD_PASSWORD=op://RabbitMQ/QueueCleaner/prod-password
RABBITMQ_PROD_VHOST=/
