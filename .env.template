# Replace the op:// references with the correct 1Password item paths and run:
# op inject -i .env.template -o .env
RABBITMQ_HOST=op://RabbitMQ/QueueCleaner/host
RABBITMQ_AMQP_PORT=5672
RABBITMQ_AMQP_PROTOCOL=amqp
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_PROTOCOL=http
RABBITMQ_USERNAME=op://RabbitMQ/QueueCleaner/username
RABBITMQ_PASSWORD=op://RabbitMQ/QueueCleaner/password
RABBITMQ_VHOST=/
# Optional timeout for RabbitMQ HTTP requests (ms)
RABBITMQ_REQUEST_TIMEOUT_MS=10000
